---
// The Bohay mark. Every call site across the landing pages and the docs goes
// through here, so the artwork changes in one place.
//
// A plain <img> pointing at the vector in public/, not `astro:assets`. This used
// to wrap `<Image>` for one reason: the source was a 1286x1286 illustration and
// something had to stop Starlight shipping the whole thing to draw a 34px mark.
// The mark is now a 2 KB SVG, so it is already smaller than any raster the
// optimiser would emit, and it stays sharp at every size it is used at here
// (16px in the demo tab strip up to 34px in a header) with one request.
//
// Same props as before (`width` / `height` / `class`), so no call site changed.
interface Props {
  width?: number;
  height?: number;
  class?: string;
  [key: string]: unknown;
}

const { width = 32, height, class: className, ...rest } = Astro.props;
---

<img
  src="/logo.svg"
  width={width}
  height={height ?? width}
  alt=""
  loading="eager"
  decoding="async"
  class:list={['bh-mark', className]}
  {...rest}
/>

<style>
  .bh-mark {
    /* The artwork is a full-bleed tile, so the corners have to be cut or it
       reads as a cropped screenshot. A percentage keeps the curve proportional
       at every size the mark is used at. */
    border-radius: 22%;
    object-fit: cover;
    display: block;
  }
</style>
